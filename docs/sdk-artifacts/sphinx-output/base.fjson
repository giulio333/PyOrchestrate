nfig.validation_policy\"><code class=\"docutils literal notranslate\"><span class=\"pre\">BaseClassConfig.validation_policy</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#PyOrchestrate.core.base.BaseClassConfig.validate\"><code class=\"docutils literal notranslate\"><span class=\"pre\">BaseClassConfig.validate()</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#PyOrchestrate.core.base.BaseClassConfig.to_dict\"><code class=\"docutils literal notranslate\"><span class=\"pre\">BaseClassConfig.to_dict()</span></code></a></li>\n</ul>\n</li>\n<li><a class=\"reference internal\" href=\"#PyOrchestrate.core.base.BaseClassPlugin\"><code class=\"docutils literal notranslate\"><span class=\"pre\">BaseClassPlugin</span></code></a></li>\n</ul>\n</li>\n<li><a class=\"reference internal\" href=\"#module-PyOrchestrate.core.base.exceptions\">PyOrchestrate.core.base.exceptions</a><ul>\n<li><a class=\"reference internal\" href=\"#PyOrchestrate.core.base.exceptions.TerminateProcess\"><code class=\"docutils literal notranslate\"><span class=\"pre\">TerminateProcess</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#PyOrchestrate.core.base.exceptions.RecoverableException\"><code class=\"docutils literal notranslate\"><span class=\"pre\">RecoverableException</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#PyOrchestrate.core.base.exceptions.NonRecoverableException\"><code class=\"docutils literal notranslate\"><span class=\"pre\">NonRecoverableException</span></code></a></li>\n</ul>\n</li>\n<li><a class=\"reference internal\" href=\"#module-PyOrchestrate.core.base.utilities\">PyOrchestrate.core.base.utilities</a><ul>\n<li><a class=\"reference internal\" href=\"#PyOrchestrate.core.base.utilities.LoggerConfig\"><code class=\"docutils literal notranslate\"><span class=\"pre\">LoggerConfig</span></code></a><ul>\n<li><a class=\"reference internal\" href=\"#PyOrchestrate.core.base.utilities.LoggerConfig.level\"><code class=\"docutils literal notranslate\"><span class=\"pre\">LoggerConfig.level</span></code></a></li>\n<li><a class=\"reference internal\" href=\"#PyOrchestrate.core.base.utilities.LoggerConfig.filename\"><code class=\"docutils literal notranslate\"><span class=\"pre\">LoggerConfig.filename</span></code></a></li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n", "display_toc": true, "page_source_suffix": ".rst", "current_page_name": "base", "sidebars": ["about.html", "searchfield.html", "navigation.html", "relations.html", "donate.html"], "alabaster_version": "1.0.0", "alabaster_version_info": [1, 0, 0]}