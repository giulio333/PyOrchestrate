lass=\"field-odd\"><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.worker_pool.WorkerPoolScheduler.stop_all\">\n<span class=\"sig-name descname\"><span class=\"pre\">stop_all</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.worker_pool.WorkerPoolScheduler.stop_all\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Cancel queued work and request stop without holding the pool lock.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.worker_pool.WorkerPoolScheduler.shutdown_all\">\n<span class=\"sig-name descname\"><span class=\"pre\">shutdown_all</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">timeout</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.worker_pool.WorkerPoolScheduler.shutdown_all\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Cancel queued work and block until every agent has terminated.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>timeout</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#float\" title=\"(in Python v3.11)\"><em>float</em></a><em> | </em><em>None</em>) \u2013 Overall budget in seconds for the cooperative wait.</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>Names of the agents that are still alive afterwards.</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#list\" title=\"(in Python v3.11)\">list</a>[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py property\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.worker_pool.WorkerPoolScheduler.all_finished\">\n<em class=\"property\"><span class=\"pre\">property</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">all_finished</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#bool\" title=\"(in Python v3.11)\"><span class=\"pre\">bool</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.worker_pool.WorkerPoolScheduler.all_finished\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py property\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.worker_pool.WorkerPoolScheduler.queue_size\">\n<em class=\"property\"><span class=\"pre\">property</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">queue_size</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><span class=\"pre\">int</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.worker_pool.WorkerPoolScheduler.queue_size\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py property\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.worker_pool.WorkerPoolScheduler.running_count\">\n<em class=\"property\"><span class=\"pre\">property</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">running_count</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><span class=\"pre\">int</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.worker_pool.WorkerPoolScheduler.running_count\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Return live running plus quarantined agents.</p>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.worker_pool.WorkerPoolScheduler.get_stats\">\n<span class=\"sig-name descname\"><span class=\"pre\">get_stats</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.worker_pool.WorkerPoolScheduler.get_stats\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#dict\" title=\"(in Python v3.11)\">dict</a></p>\n</dd>\n</dl>\n</dd></dl>\n\n</dd></dl>\n\n</section>\n<section id=\"module-PyOrchestrate.core.orchestrator.event_bus\">\n<span id=\"pyorchestrate-core-orchestrator-event-bus\"></span><h2>PyOrchestrate.core.orchestrator.event_bus<a class=\"headerlink\" href=\"#module-PyOrchestrate.core.orchestrator.event_bus\" title=\"Link to this heading\">\u00b6</a></h2>\n<p>Orchestrator Event Bus.</p>\n<p>This module provides the OrchestratorEventBus class that wraps EventManager and EventStore\nto provide a unified interface for event emission and history tracking. It automatically\nrecords events to the event store when they are emitted, simplifying event management.</p>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.event_bus.</span></span><span class=\"sig-name descname\"><span class=\"pre\">OrchestratorEventBus</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_store</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#object\" title=\"(in Python v3.11)\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">object</span></code></a></p>\n<p>Centralized event system with automatic history tracking.</p>\n<p>The OrchestratorEventBus combines EventManager (for callbacks) and EventStore\n(for history) into a single, unified interface. When events are emitted, they\nare automatically tracked to the event store, eliminating the need for manual\nhistory recording.</p>\n<p>This class provides:\n- Event callback registration via EventManager\n- Automatic event history tracking to EventStore\n- Query API for event history analysis\n- Unified interface for all event operations</p>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"n\">event_store</span> <span class=\"o\">=</span> <span class=\"n\">EventStore</span><span class=\"p\">(</span><span class=\"n\">capacity</span><span class=\"o\">=</span><span class=\"mi\">1000</span><span class=\"p\">)</span>\n<span class=\"n\">event_bus</span> <span class=\"o\">=</span> <span class=\"n\">OrchestratorEventBus</span><span class=\"p\">(</span><span class=\"n\">event_store</span><span class=\"p\">)</span>\n\n<span class=\"c1\"># Register callback</span>\n<span class=\"n\">event_bus</span><span class=\"o\">.</span><span class=\"n\">register_callback</span><span class=\"p\">(</span>\n    <span class=\"n\">OrchestratorEvent</span><span class=\"o\">.</span><span class=\"n\">AGENT_STARTED</span><span class=\"p\">,</span>\n    <span class=\"k\">lambda</span> <span class=\"n\">agent_name</span><span class=\"p\">:</span> <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">\"Agent </span><span class=\"si\">{</span><span class=\"n\">agent_name</span><span class=\"si\">}</span><span class=\"s2\"> started\"</span><span class=\"p\">)</span>\n<span class=\"p\">)</span>\n\n<span class=\"c1\"># Emit event (automatically tracked to history)</span>\n<span class=\"n\">event_bus</span><span class=\"o\">.</span><span class=\"n\">emit</span><span class=\"p\">(</span><span class=\"n\">OrchestratorEvent</span><span class=\"o\">.</span><span class=\"n\">AGENT_STARTED</span><span class=\"p\">,</span> <span class=\"n\">agent_name</span><span class=\"o\">=</span><span class=\"s2\">\"agent1\"</span><span class=\"p\">)</span>\n\n<span class=\"c1\"># Query history</span>\n<span class=\"n\">history</span> <span class=\"o\">=</span> <span class=\"n\">event_bus</span><span class=\"o\">.</span><span class=\"n\">get_history</span><span class=\"p\">(</span><span class=\"n\">agent_name</span><span class=\"o\">=</span><span class=\"s2\">\"agent1\"</span><span class=\"p\">)</span>\n</pre></div>\n</div>\n<dl class=\"simple\">\n<dt>Thread Safety:</dt><dd><p>Both EventManager and EventStore are thread-safe, making this class\nsafe for use in multi-threaded environments.</p>\n</dd>\n</dl>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>event_store</strong> (<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventStore\" title=\"PyOrchestrate.core.orchestrator.event_store.EventStore\"><em>EventStore</em></a>)</p>\n</dd>\n</dl>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus.register_callback\">\n<span class=\"sig-name descname\"><span class=\"pre\">register_callback</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_type</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">callback</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus.register_callback\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Register a callback for a specific event type.</p>\n<p>The callback will be invoked whenever the event is emitted. Callbacks\nreceive event data as keyword arguments.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>event_type</strong> (<a class=\"reference internal\" href=\"../utilities/#PyOrchestrate.core.utilities.event.OrchestratorEvent\" title=\"PyOrchestrate.core.utilities.event.OrchestratorEvent\"><em>OrchestratorEvent</em></a>) \u2013 The orchestrator event to listen for</p></li>\n<li><p><strong>callback</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Callable\" title=\"(in Python v3.11)\"><em>Callable</em></a>) \u2013 Function to call when event occurs (receives event data as kwargs)</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"k\">def</span><span class=\"w\"> </span><span class=\"nf\">on_agent_ready</span><span class=\"p\">(</span><span class=\"n\">agent_name</span><span class=\"p\">:</span> <span class=\"nb\">str</span><span class=\"p\">,</span> <span class=\"o\">**</span><span class=\"n\">kwargs</span><span class=\"p\">):</span>\n    <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">\"Agent </span><span class=\"si\">{</span><span class=\"n\">agent_name</span><span class=\"si\">}</span><span class=\"s2\"> is ready\"</span><span class=\"p\">)</span>\n\n<span class=\"n\">event_bus</span><span class=\"o\">.</span><span class=\"n\">register_callback</span><span class=\"p\">(</span>\n    <span class=\"n\">OrchestratorEvent</span><span class=\"o\">.</span><span class=\"n\">AGENT_READY</span><span class=\"p\">,</span>\n    <span class=\"n\">on_agent_ready</span>\n<span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus.emit\">\n<span class=\"sig-name descname\"><span class=\"pre\">emit</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_type</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus.emit\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Emit an event and automatically track it to history.</p>\n<p>This method performs two operations:\n1. Emits the event to all registered callbacks via EventManager\n2. Records the event to EventStore for history tracking</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>event_type</strong> (<a class=\"reference internal\" href=\"../utilities/#PyOrchestrate.core.utilities.event.OrchestratorEvent\" title=\"PyOrchestrate.core.utilities.event.OrchestratorEvent\"><em>OrchestratorEvent</em></a>) \u2013 The orchestrator event to emit</p></li>\n<li><p><strong>**kwargs</strong> \u2013 Event data passed to callbacks and stored in history</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"n\">event_bus</span><span class=\"o\">.</span><span class=\"n\">emit</span><span class=\"p\">(</span>\n    <span class=\"n\">OrchestratorEvent</span><span class=\"o\">.</span><span class=\"n\">AGENT_ERROR</span><span class=\"p\">,</span>\n    <span class=\"n\">agent_name</span><span class=\"o\">=</span><span class=\"s2\">\"agent1\"</span><span class=\"p\">,</span>\n    <span class=\"n\">error_message</span><span class=\"o\">=</span><span class=\"s2\">\"Connection failed\"</span>\n<span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus.get_history\">\n<span class=\"sig-name descname\"><span class=\"pre\">get_history</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_type</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">limit</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">100</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus.get_history\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Query event history.</p>\n<p>Returns a list of event records matching the specified filters.\nIf no filters are provided, returns all events.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 Filter by agent name (optional)</p></li>\n<li><p><strong>event_type</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 Filter by event type (optional)</p></li>\n<li><p><strong>limit</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>) \u2013 Maximum number of events to return (default: 100)</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>List of matching event records</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>List[<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord\" title=\"PyOrchestrate.core.orchestrator.event_store.EventRecord\">EventRecord</a>]</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"c1\"># Get all events for specific agent</span>\n<span class=\"n\">agent_events</span> <span class=\"o\">=</span> <span class=\"n\">event_bus</span><span class=\"o\">.</span><span class=\"n\">get_history</span><span class=\"p\">(</span><span class=\"n\">agent_name</span><span class=\"o\">=</span><span class=\"s2\">\"agent1\"</span><span class=\"p\">)</span>\n\n<span class=\"c1\"># Get last 10 error events</span>\n<span class=\"n\">errors</span> <span class=\"o\">=</span> <span class=\"n\">event_bus</span><span class=\"o\">.</span><span class=\"n\">get_history</span><span class=\"p\">(</span>\n    <span class=\"n\">event_type</span><span class=\"o\">=</span><span class=\"s2\">\"agent_error\"</span><span class=\"p\">,</span>\n    <span class=\"n\">limit</span><span class=\"o\">=</span><span class=\"mi\">10</span>\n<span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus.get_agent_timeline\">\n<span class=\"sig-name descname\"><span class=\"pre\">get_agent_timeline</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">limit</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">100</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus.get_agent_timeline\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get complete event timeline for a specific agent.</p>\n<p>Returns all events related to the specified agent in chronological order.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 Name of the agent</p></li>\n<li><p><strong>limit</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>) \u2013 Maximum number of events to return (default: 100)</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>Chronological list of events for the agent</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>List[<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord\" title=\"PyOrchestrate.core.orchestrator.event_store.EventRecord\">EventRecord</a>]</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"n\">timeline</span> <span class=\"o\">=</span> <span class=\"n\">event_bus</span><span class=\"o\">.</span><span class=\"n\">get_agent_timeline</span><span class=\"p\">(</span><span class=\"s2\">\"agent1\"</span><span class=\"p\">)</span>\n<span class=\"k\">for</span> <span class=\"n\">event</span> <span class=\"ow\">in</span> <span class=\"n\">timeline</span><span class=\"p\">:</span>\n    <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">\"</span><span class=\"si\">{</span><span class=\"n\">event</span><span class=\"o\">.</span><span class=\"n\">timestamp</span><span class=\"si\">}</span><span class=\"s2\">: </span><span class=\"si\">{</span><span class=\"n\">event</span><span class=\"o\">.</span><span class=\"n\">event_name</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus.get_stats\">\n<span class=\"sig-name descname\"><span class=\"pre\">get_stats</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus.get_stats\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get event statistics.</p>\n<p>Returns statistics about recorded events, optionally filtered by agent.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 Agent name to filter statistics (optional)</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>Statistics dictionary with event counts</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#dict\" title=\"(in Python v3.11)\">dict</a></p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"c1\"># Global statistics</span>\n<span class=\"n\">global_stats</span> <span class=\"o\">=</span> <span class=\"n\">event_bus</span><span class=\"o\">.</span><span class=\"n\">get_stats</span><span class=\"p\">()</span>\n\n<span class=\"c1\"># Agent-specific statistics</span>\n<span class=\"n\">agent_stats</span> <span class=\"o\">=</span> <span class=\"n\">event_bus</span><span class=\"o\">.</span><span class=\"n\">get_stats</span><span class=\"p\">(</span><span class=\"n\">agent_name</span><span class=\"o\">=</span><span class=\"s2\">\"agent1\"</span><span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus.shutdown\">\n<span class=\"sig-name descname\"><span class=\"pre\">shutdown</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus.shutdown\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Shutdown the event bus.</p>\n<p>Stops the EventManager\u2019s executor and prevents new event emissions.\nCall this method during orchestrator shutdown to ensure clean termination.</p>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"c1\"># During orchestrator shutdown</span>\n<span class=\"n\">event_bus</span><span class=\"o\">.</span><span class=\"n\">shutdown</span><span class=\"p\">()</span>\n</pre></div>\n</div>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n</dd></dl>\n\n</section>\n<section id=\"module-PyOrchestrate.core.orchestrator.event_store\">\n<span id=\"pyorchestrate-core-orchestrator-event-store\"></span><h2>PyOrchestrate.core.orchestrator.event_store<a class=\"headerlink\" href=\"#module-PyOrchestrate.core.orchestrator.event_store\" title=\"Link to this heading\">\u00b6</a></h2>\n<p>Event Store for PyOrchestrate - Ring buffer based event history</p>\n<p>This module provides efficient, lock-safe event storage with constant memory usage.\nUses a ring buffer (deque with maxlen) for O(1) append operations and minimal overhead.</p>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventRecord\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.event_store.</span></span><span class=\"sig-name descname\"><span class=\"pre\">EventRecord</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">seq</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">t_wall</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">t_mono_ns</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">category</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_name</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">severity</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">data</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.NamedTuple\" title=\"(in Python v3.11)\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">NamedTuple</span></code></a></p>\n<p>Immutable event record with minimal overhead.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Variables<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>seq</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>) \u2013 Sequential event number</p></li>\n<li><p><strong>t_wall</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#float\" title=\"(in Python v3.11)\"><em>float</em></a>) \u2013 Wall clock time (time.time())</p></li>\n<li><p><strong>t_mono_ns</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>) \u2013 Monotonic time in nanoseconds for robust ordering</p></li>\n<li><p><strong>category</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 Event category (\u201corchestrator\u201d | \u201cagent\u201d | \u201ccli\u201d)</p></li>\n<li><p><strong>event_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 Event type (e.g., \u201cAGENT_STARTED\u201d, \u201cQUEUED\u201d, \u201cCLI_COMMAND\u201d)</p></li>\n<li><p><strong>agent</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 Agent name if applicable</p></li>\n<li><p><strong>severity</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 Event severity (\u201cINFO\u201d | \u201cWARN\u201d | \u201cERROR\u201d)</p></li>\n<li><p><strong>data</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#dict\" title=\"(in Python v3.11)\"><em>dict</em></a><em>[</em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em>, </em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em>] </em><em>| </em><em>None</em>) \u2013 Optional payload data (truncated for efficiency)</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><ul class=\"simple\">\n<li><p><strong>seq</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>)</p></li>\n<li><p><strong>t_wall</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#float\" title=\"(in Python v3.11)\"><em>float</em></a>)</p></li>\n<li><p><strong>t_mono_ns</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>)</p></li>\n<li><p><strong>category</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n<li><p><strong>event_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n<li><p><strong>agent</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>)</p></li>\n<li><p><strong>severity</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n<li><p><strong>data</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#dict\" title=\"(in Python v3.11)\"><em>dict</em></a><em>[</em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em>, </em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em>] </em><em>| </em><em>None</em>)</p></li>\n</ul>\n</dd>\n</dl>\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventRecord.seq\">\n<span class=\"sig-name descname\"><span class=\"pre\">seq</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><span class=\"pre\">int</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord.seq\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Alias for field number 0</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventRecord.t_wall\">\n<span class=\"sig-name descname\"><span class=\"pre\">t_wall</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#float\" title=\"(in Python v3.11)\"><span class=\"pre\">float</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord.t_wall\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Alias for field number 1</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventRecord.t_mono_ns\">\n<span class=\"sig-name descname\"><span class=\"pre\">t_mono_ns</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><span class=\"pre\">int</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord.t_mono_ns\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Alias for field number 2</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventRecord.category\">\n<span class=\"sig-name descname\"><span class=\"pre\">category</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><span class=\"pre\">str</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord.category\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Alias for field number 3</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventRecord.event_name\">\n<span class=\"sig-name descname\"><span class=\"pre\">event_name</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><span class=\"pre\">str</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord.event_name\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Alias for field number 4</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventRecord.agent\">\n<span class=\"sig-name descname\"><span class=\"pre\">agent</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><span class=\"pre\">str</span></a><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">|</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/constants.html#None\" title=\"(in Python v3.11)\"><span class=\"pre\">None</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord.agent\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Alias for field number 5</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventRecord.severity\">\n<span class=\"sig-name descname\"><span class=\"pre\">severity</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><span class=\"pre\">str</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord.severity\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Alias for field number 6</p>\n</dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventRecord.data\">\n<span class=\"sig-name descname\"><span class=\"pre\">data</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#dict\" title=\"(in Python v3.11)\"><span class=\"pre\">dict</span></a><span class=\"p\"><span class=\"pre\">[</span></span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><span class=\"pre\">str</span></a><span class=\"p\"><span class=\"pre\">,</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><span class=\"pre\">str</span></a><span class=\"p\"><span class=\"pre\">]</span></span><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">|</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/constants.html#None\" title=\"(in Python v3.11)\"><span class=\"pre\">None</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord.data\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Alias for field number 7</p>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventRecord.to_dict\">\n<span class=\"sig-name descname\"><span class=\"pre\">to_dict</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord.to_dict\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Return a JSON-serializable dict representation of the event.</p>\n<p>Includes an ISO8601 <cite>timestamp</cite> string for convenience while preserving\nnumeric <cite>t_wall</cite> and <cite>t_mono_ns</cite> for consumers that need them.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Dict\" title=\"(in Python v3.11)\"><em>Dict</em></a>[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>, <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#object\" title=\"(in Python v3.11)\">object</a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventRecord.to_json\">\n<span class=\"sig-name descname\"><span class=\"pre\">to_json</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">json_kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord.to_json\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Return a JSON string representation of the event.</p>\n<p>Passes json_kwargs to json.dumps (e.g. indent=2, ensure_ascii=False).</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a></p>\n</dd>\n</dl>\n</dd></dl>\n\n</dd></dl>\n\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.StorePolicy\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.event_store.</span></span><span class=\"sig-name descname\"><span class=\"pre\">StorePolicy</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span><span class=\"n\"><span class=\"pre\">args</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.StorePolicy\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Protocol\" title=\"(in Python v3.11)\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">Protocol</span></code></a></p>\n<p>Protocol that defines the interface for event storage policies.</p>\n<p>Implementations can optimize storage strategies based on specific event types\n(e.g., keep only latest heartbeat per agent vs. full history for errors).</p>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.StorePolicy.append\">\n<span class=\"sig-name descname\"><span class=\"pre\">append</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">e</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.StorePolicy.append\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Add a new event record to the store.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>e</strong> (<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord\" title=\"PyOrchestrate.core.orchestrator.event_store.EventRecord\"><em>EventRecord</em></a>)</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.StorePolicy.last\">\n<span class=\"sig-name descname\"><span class=\"pre\">last</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">n</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">100</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_name</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">after_seq</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.StorePolicy.last\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Retrieve the last N events with optional filtering.</p>\n<p>A non-positive <cite>n</cite> must return an empty list.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>n</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>)</p></li>\n<li><p><strong>agent</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>)</p></li>\n<li><p><strong>event_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>)</p></li>\n<li><p><strong>after_seq</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a><em> | </em><em>None</em>)</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.List\" title=\"(in Python v3.11)\"><em>List</em></a>[<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord\" title=\"PyOrchestrate.core.orchestrator.event_store.EventRecord\"><em>EventRecord</em></a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.StorePolicy.stats\">\n<span class=\"sig-name descname\"><span class=\"pre\">stats</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.StorePolicy.stats\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get event count statistics, optionally for a specific agent.</p>\n<p>EventStore.stats() sums these counts across every configured store; an\nimplementation that raises instead is skipped rather than failing the\nquery.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>agent</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>)</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Dict\" title=\"(in Python v3.11)\"><em>Dict</em></a>[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>, <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\">int</a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.StorePolicy.capacity_info\">\n<span class=\"sig-name descname\"><span class=\"pre\">capacity_info</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.StorePolicy.capacity_info\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get capacity and usage information for this store.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Dict\" title=\"(in Python v3.11)\"><em>Dict</em></a>[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>, <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\">int</a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n</dd></dl>\n\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.RingBufferStore\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.event_store.</span></span><span class=\"sig-name descname\"><span class=\"pre\">RingBufferStore</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">capacity</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.RingBufferStore\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.StorePolicy\" title=\"PyOrchestrate.core.orchestrator.event_store.StorePolicy\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">StorePolicy</span></code></a></p>\n<p>Fixed-capacity ring buffer store for event history.</p>\n<p>Features:\n- FIFO behavior: oldest events are automatically evicted when capacity is reached\n- O(1) append operations with constant memory usage\n- Maintains real-time event count statistics\n- Suitable for general event storage (errors, status changes, etc.)</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>capacity</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>)</p>\n</dd>\n</dl>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.RingBufferStore.append\">\n<span class=\"sig-name descname\"><span class=\"pre\">append</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">e</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.RingBufferStore.append\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Add a new event to the ring buffer.</p>\n<p>If the buffer is at capacity, the oldest event is automatically removed.\nUpdates internal statistics counters for fast stats() queries.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>e</strong> (<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord\" title=\"PyOrchestrate.core.orchestrator.event_store.EventRecord\"><em>EventRecord</em></a>) \u2013 Event record to store</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.RingBufferStore.last\">\n<span class=\"sig-name descname\"><span class=\"pre\">last</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">n</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">100</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_name</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">after_seq</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.RingBufferStore.last\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Retrieve the most recent events from the ring buffer.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>n</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>) \u2013 Maximum number of events to return. Non-positive values return\nan empty list.</p></li>\n<li><p><strong>agent</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 Filter by specific agent name</p></li>\n<li><p><strong>event_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 Filter by specific event type</p></li>\n<li><p><strong>after_seq</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a><em> | </em><em>None</em>) \u2013 Only return events with sequence number &gt; after_seq</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>List of EventRecord objects, most recent last</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.List\" title=\"(in Python v3.11)\"><em>List</em></a>[<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord\" title=\"PyOrchestrate.core.orchestrator.event_store.EventRecord\"><em>EventRecord</em></a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.RingBufferStore.stats\">\n<span class=\"sig-name descname\"><span class=\"pre\">stats</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.RingBufferStore.stats\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get event count statistics with O(1) complexity.</p>\n<p>Counters track every appended event, so they keep growing after the\nbuffer starts evicting: they answer \u201chow many events were recorded\u201d,\nnot \u201chow many are still retained\u201d. Use capacity_info() for the\nretained size.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>agent</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 If provided, return stats only for this agent</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>Dictionary with event_name -&gt; count mappings</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Dict\" title=\"(in Python v3.11)\"><em>Dict</em></a>[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>, <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\">int</a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.RingBufferStore.capacity_info\">\n<span class=\"sig-name descname\"><span class=\"pre\">capacity_info</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.RingBufferStore.capacity_info\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get current capacity and usage information for the ring buffer.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>Dictionary with capacity, current_size, oldest_seq, newest_seq</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Dict\" title=\"(in Python v3.11)\"><em>Dict</em></a>[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>, <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\">int</a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n</dd></dl>\n\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.BucketRingStore\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.event_store.</span></span><span class=\"sig-name descname\"><span class=\"pre\">BucketRingStore</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">per_agent_capacity</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.BucketRingStore\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.StorePolicy\" title=\"PyOrchestrate.core.orchestrator.event_store.StorePolicy\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">StorePolicy</span></code></a></p>\n<p>Per-agent ring buffer store optimized for tracking latest events per agent.</p>\n<p>Features:\n- Separate ring buffer for each agent (bounded per-agent history)\n- Perfect for heartbeat monitoring: keeps only last N heartbeats per agent\n- O(1) append, efficient agent-specific queries\n- Events without agent are stored in a shared \u201c_none\u201d bucket\n- Memory usage scales with number of active agents</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>per_agent_capacity</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>)</p>\n</dd>\n</dl>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.BucketRingStore.append\">\n<span class=\"sig-name descname\"><span class=\"pre\">append</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">e</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.BucketRingStore.append\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Add event to the appropriate agent bucket.</p>\n<p>Creates new buckets automatically for new agents.\nOldest events are evicted when per-agent capacity is reached.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>e</strong> (<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord\" title=\"PyOrchestrate.core.orchestrator.event_store.EventRecord\"><em>EventRecord</em></a>) \u2013 Event record to store</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.BucketRingStore.last\">\n<span class=\"sig-name descname\"><span class=\"pre\">last</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">n</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">100</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_name</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">after_seq</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.BucketRingStore.last\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Retrieve recent events from per-agent buckets.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>n</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>) \u2013 Maximum number of events to return. Non-positive values return\nan empty list.</p></li>\n<li><p><strong>agent</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 If specified, only return events from this agent\u2019s bucket</p></li>\n<li><p><strong>event_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 Filter by specific event type</p></li>\n<li><p><strong>after_seq</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a><em> | </em><em>None</em>) \u2013 Only return events with sequence number &gt; after_seq</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>List of EventRecord objects, sorted by sequence number (most recent last)</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.List\" title=\"(in Python v3.11)\"><em>List</em></a>[<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord\" title=\"PyOrchestrate.core.orchestrator.event_store.EventRecord\"><em>EventRecord</em></a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.BucketRingStore.stats\">\n<span class=\"sig-name descname\"><span class=\"pre\">stats</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.BucketRingStore.stats\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get event count statistics with O(1) complexity.</p>\n<p>Counters track every appended event, so they keep growing after the\nper-agent buckets start evicting: they answer \u201chow many events were\nrecorded\u201d, not \u201chow many are still retained\u201d. Use capacity_info() for\nthe retained sizes.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>agent</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 If provided, return stats only for this agent</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>Dictionary with event_name -&gt; count mappings</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Dict\" title=\"(in Python v3.11)\"><em>Dict</em></a>[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>, <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\">int</a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.BucketRingStore.capacity_info\">\n<span class=\"sig-name descname\"><span class=\"pre\">capacity_info</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.BucketRingStore.capacity_info\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get capacity and usage information for all agent buckets.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>Dictionary with per_agent_capacity, agents_known, approx_total_capacity,\ncurrent_size, oldest_seq, newest_seq</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Dict\" title=\"(in Python v3.11)\"><em>Dict</em></a>[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>, <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\">int</a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n</dd></dl>\n\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventStore\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.event_store.</span></span><span class=\"sig-name descname\"><span class=\"pre\">EventStore</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">capacity</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">5000</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">payload_max_bytes</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">256</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_policies</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventStore\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#object\" title=\"(in Python v3.11)\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">object</span></code></a></p>\n<p>High-performance event storage with constant memory usage.</p>\n<p>Features:\n- Ring buffer with fixed capacity (no memory growth)\n- Thread-safe operations with minimal locking\n- Truncated payload to prevent memory bloat\n- Real-time aggregated counters for instant reports\n- Robust temporal ordering with monotonic timestamps\n- Pluggable storage policies per category (e.g., ring buffer vs. per-agent last-N)</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>capacity</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>)</p></li>\n<li><p><strong>payload_max_bytes</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>)</p></li>\n<li><p><strong>event_policies</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Dict\" title=\"(in Python v3.11)\"><em>Dict</em></a><em>[</em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em>, </em><a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.StorePolicy\" title=\"PyOrchestrate.core.orchestrator.event_store.StorePolicy\"><em>StorePolicy</em></a><em>] </em><em>| </em><em>None</em>)</p></li>\n</ul>\n</dd>\n</dl>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventStore.record\">\n<span class=\"sig-name descname\"><span class=\"pre\">record</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">*</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">category</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_name</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">severity</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">'INFO'</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">data</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventStore.record\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Record a new event with O(1) complexity.</p>\n<p>Events are routed to appropriate storage policies based on event_name.\nIf no specific policy exists for the event_name, uses the default ring buffer.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>category</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 Event category (\u201corchestrator\u201d, \u201cagent\u201d, \u201ccli\u201d)</p></li>\n<li><p><strong>event_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 Event type (e.g., \u201cagent_heartbeat\u201d, \u201cagent_error\u201d)</p></li>\n<li><p><strong>agent</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 Agent name (optional, for agent-specific events)</p></li>\n<li><p><strong>severity</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 Event severity level (\u201cINFO\u201d, \u201cWARN\u201d, \u201cERROR\u201d)</p></li>\n<li><p><strong>data</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#dict\" title=\"(in Python v3.11)\"><em>dict</em></a><em>[</em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em>, </em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em>] </em><em>| </em><em>None</em>) \u2013 Optional payload data (will be truncated if too long)</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"n\">store</span><span class=\"o\">.</span><span class=\"n\">record</span><span class=\"p\">(</span>\n    <span class=\"n\">category</span><span class=\"o\">=</span><span class=\"s2\">\"agent\"</span><span class=\"p\">,</span>\n    <span class=\"n\">event_name</span><span class=\"o\">=</span><span class=\"s2\">\"agent_heartbeat\"</span><span class=\"p\">,</span>\n    <span class=\"n\">agent</span><span class=\"o\">=</span><span class=\"s2\">\"worker1\"</span><span class=\"p\">,</span>\n    <span class=\"n\">data</span><span class=\"o\">=</span><span class=\"p\">{</span><span class=\"s2\">\"timestamp\"</span><span class=\"p\">:</span> <span class=\"s2\">\"2023-08-19T10:30:00\"</span><span class=\"p\">}</span>\n<span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventStore.last\">\n<span class=\"sig-name descname\"><span class=\"pre\">last</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">n</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">100</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_name</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">after_seq</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventStore.last\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Retrieve recent events with optional filtering.</p>\n<p>Storage behavior:</p>\n<ul class=\"simple\">\n<li><p>If event_name is None: Merges results from all configured stores (default + any event-specific stores)</p></li>\n<li><p>If event_name is specified: Uses the event-specific store if configured,\notherwise falls back to the default ring buffer</p></li>\n</ul>\n<p>This design allows optimized storage per event type while maintaining\nbackward compatibility for general queries.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>n</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>) \u2013 Maximum number of events to return. Non-positive values return\nan empty list.</p></li>\n<li><p><strong>agent</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 Filter by agent name (only events from this agent)</p></li>\n<li><p><strong>event_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 Filter by event type (single event name only).\nIf None, searches in the default store containing all events.</p></li>\n<li><p><strong>after_seq</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a><em> | </em><em>None</em>) \u2013 Return only events after this sequence number</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>List of EventRecord objects, ordered by sequence number (most recent last)</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.List\" title=\"(in Python v3.11)\"><em>List</em></a>[<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord\" title=\"PyOrchestrate.core.orchestrator.event_store.EventRecord\"><em>EventRecord</em></a>]</p>\n</dd>\n</dl>\n<p class=\"rubric\">Examples</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"c1\"># Get last 50 events of any type (uses default ring buffer)</span>\n<span class=\"n\">all_events</span> <span class=\"o\">=</span> <span class=\"n\">store</span><span class=\"o\">.</span><span class=\"n\">last</span><span class=\"p\">(</span><span class=\"mi\">50</span><span class=\"p\">)</span>\n\n<span class=\"c1\"># Get last 10 heartbeats (uses heartbeat-specific store if configured)</span>\n<span class=\"n\">heartbeats</span> <span class=\"o\">=</span> <span class=\"n\">store</span><span class=\"o\">.</span><span class=\"n\">last</span><span class=\"p\">(</span><span class=\"mi\">10</span><span class=\"p\">,</span> <span class=\"n\">event_name</span><span class=\"o\">=</span><span class=\"s2\">\"agent_heartbeat\"</span><span class=\"p\">)</span>\n\n<span class=\"c1\"># Get last 20 events from specific agent (any event type)</span>\n<span class=\"n\">agent_events</span> <span class=\"o\">=</span> <span class=\"n\">store</span><span class=\"o\">.</span><span class=\"n\">last</span><span class=\"p\">(</span><span class=\"mi\">20</span><span class=\"p\">,</span> <span class=\"n\">agent</span><span class=\"o\">=</span><span class=\"s2\">\"worker1\"</span><span class=\"p\">)</span>\n\n<span class=\"c1\"># Get heartbeats from specific agent</span>\n<span class=\"n\">agent_heartbeats</span> <span class=\"o\">=</span> <span class=\"n\">store</span><span class=\"o\">.</span><span class=\"n\">last</span><span class=\"p\">(</span><span class=\"mi\">5</span><span class=\"p\">,</span> <span class=\"n\">agent</span><span class=\"o\">=</span><span class=\"s2\">\"worker1\"</span><span class=\"p\">,</span> <span class=\"n\">event_name</span><span class=\"o\">=</span><span class=\"s2\">\"agent_heartbeat\"</span><span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventStore.latest\">\n<span class=\"sig-name descname\"><span class=\"pre\">latest</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_name</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventStore.latest\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get the latest event of a specific type, optimized for O(1) access.</p>\n<p>Perfect for heartbeat monitoring and status checks.\nUses the event-specific store if configured, providing efficient access\nto the most recent event without scanning through history.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>event_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 Event type to look for (e.g., \u201cagent_heartbeat\u201d)</p></li>\n<li><p><strong>agent</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 Agent name. If None, gets latest across all agents</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>Latest EventRecord or None if not found</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord\" title=\"PyOrchestrate.core.orchestrator.event_store.EventRecord\"><em>EventRecord</em></a> | None</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"c1\"># Check if agent is alive (latest heartbeat)</span>\n<span class=\"n\">latest_hb</span> <span class=\"o\">=</span> <span class=\"n\">store</span><span class=\"o\">.</span><span class=\"n\">latest</span><span class=\"p\">(</span><span class=\"s2\">\"agent_heartbeat\"</span><span class=\"p\">,</span> <span class=\"s2\">\"worker1\"</span><span class=\"p\">)</span>\n<span class=\"k\">if</span> <span class=\"n\">latest_hb</span> <span class=\"ow\">and</span> <span class=\"n\">time</span><span class=\"o\">.</span><span class=\"n\">time</span><span class=\"p\">()</span> <span class=\"o\">-</span> <span class=\"n\">latest_hb</span><span class=\"o\">.</span><span class=\"n\">t_wall</span> <span class=\"o\">&lt;</span> <span class=\"mi\">30</span><span class=\"p\">:</span>\n    <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s2\">\"Agent is alive\"</span><span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventStore.latest_all_agents\">\n<span class=\"sig-name descname\"><span class=\"pre\">latest_all_agents</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventStore.latest_all_agents\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get the latest event of a specific type for all agents.</p>\n<p>Extremely useful for heartbeat monitoring: get the last heartbeat\nfrom every agent in a single O(agents) operation.</p>\n<p>Optimized implementations:\n- BucketRingStore: Iterates through per-agent buckets efficiently\n- RingBufferStore: Scans events and groups by agent</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>event_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 Event type to look for (e.g., \u201cagent_heartbeat\u201d)</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>Dictionary mapping agent_name -&gt; latest EventRecord\n(excludes agents with no events of this type)</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Dict\" title=\"(in Python v3.11)\"><em>Dict</em></a>[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>, <a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventRecord\" title=\"PyOrchestrate.core.orchestrator.event_store.EventRecord\"><em>EventRecord</em></a>]</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"c1\"># Monitor all agent heartbeats</span>\n<span class=\"n\">heartbeats</span> <span class=\"o\">=</span> <span class=\"n\">store</span><span class=\"o\">.</span><span class=\"n\">latest_all_agents</span><span class=\"p\">(</span><span class=\"s2\">\"agent_heartbeat\"</span><span class=\"p\">)</span>\n<span class=\"k\">for</span> <span class=\"n\">agent</span><span class=\"p\">,</span> <span class=\"n\">hb</span> <span class=\"ow\">in</span> <span class=\"n\">heartbeats</span><span class=\"o\">.</span><span class=\"n\">items</span><span class=\"p\">():</span>\n    <span class=\"n\">age</span> <span class=\"o\">=</span> <span class=\"n\">time</span><span class=\"o\">.</span><span class=\"n\">time</span><span class=\"p\">()</span> <span class=\"o\">-</span> <span class=\"n\">hb</span><span class=\"o\">.</span><span class=\"n\">t_wall</span>\n    <span class=\"k\">if</span> <span class=\"n\">age</span> <span class=\"o\">&gt;</span> <span class=\"mi\">30</span><span class=\"p\">:</span>\n        <span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">\"Agent </span><span class=\"si\">{</span><span class=\"n\">agent</span><span class=\"si\">}</span><span class=\"s2\"> missed heartbeat (</span><span class=\"si\">{</span><span class=\"n\">age</span><span class=\"si\">:</span><span class=\"s2\">.1f</span><span class=\"si\">}</span><span class=\"s2\">s ago)\"</span><span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventStore.stats\">\n<span class=\"sig-name descname\"><span class=\"pre\">stats</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventStore.stats\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get aggregated event count statistics with O(1) complexity.</p>\n<p>Counts are summed across every configured store, so events routed to an\nevent-specific policy are reported alongside the ones in the default\nring buffer. A custom StorePolicy whose stats() raises is skipped rather\nthan failing the whole query.</p>\n<p>The counters are cumulative since the store was created: they do not\nshrink when a buffer evicts its oldest events. Use get_capacity_info()\nfor the number of events currently retained.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>agent</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>) \u2013 Get stats for specific agent, or global stats if None</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>Dictionary with \u201cby_type\u201d key containing event_name -&gt; count mappings</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Dict\" title=\"(in Python v3.11)\"><em>Dict</em></a>[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>, <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Dict\" title=\"(in Python v3.11)\"><em>Dict</em></a>[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>, <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\">int</a>]]</p>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"n\">stats</span> <span class=\"o\">=</span> <span class=\"n\">store</span><span class=\"o\">.</span><span class=\"n\">stats</span><span class=\"p\">()</span>\n<span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"sa\">f</span><span class=\"s2\">\"Total heartbeats: </span><span class=\"si\">{</span><span class=\"n\">stats</span><span class=\"p\">[</span><span class=\"s1\">'by_type'</span><span class=\"p\">]</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s1\">'agent_heartbeat'</span><span class=\"p\">,</span><span class=\"w\"> </span><span class=\"mi\">0</span><span class=\"p\">)</span><span class=\"si\">}</span><span class=\"s2\">\"</span><span class=\"p\">)</span>\n</pre></div>\n</div>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.event_store.EventStore.get_capacity_info\">\n<span class=\"sig-name descname\"><span class=\"pre\">get_capacity_info</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventStore.get_capacity_info\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get current capacity and usage information for all storage policies.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><ul class=\"simple\">\n<li><p>\u201cstores\u201d: Dictionary mapping store_name -&gt; capacity_info for ALL stores\n- \u201c__default__\u201d: The default RingBufferStore capacity info\n- event-specific stores (e.g., \u201cagent_heartbeat\u201d): Custom store capacity info</p></li>\n<li><p>\u201dsummary\u201d: High-level aggregated information\n- \u201ctotal_stores\u201d: Total number of configured stores\n- \u201ctotal_events_approx\u201d: Approximate total events across all stores</p></li>\n</ul>\n</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>Dictionary with</p>\n</dd>\n</dl>\n<p>Useful for monitoring memory usage and detecting storage issues.</p>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"n\">info</span> <span class=\"o\">=</span> <span class=\"n\">store</span><span class=\"o\">.</span><span class=\"n\">get_capacity_info</span><span class=\"p\">()</span>\n<span class=\"n\">default_info</span> <span class=\"o\">=</span> <span class=\"n\">info</span><span class=\"p\">[</span><span class=\"s1\">'stores'</span><span class=\"p\">][</span><span class=\"s1\">'__default__'</span><span class=\"p\">]</span>\n<span class=\"n\">hb_info</span> <span class=\"o\">=</span> <span class=\"n\">info</span><span class=\"p\">[</span><span class=\"s1\">'stores'</span><span class=\"p\">]</span><span class=\"o\">.</span><span class=\"n\">get</span><span class=\"p\">(</span><span class=\"s1\">'agent_heartbeat'</span><span class=\"p\">,</span> <span class=\"p\">{})</span>\n<span class=\"n\">total_stores</span> <span class=\"o\">=</span> <span class=\"n\">info</span><span class=\"p\">[</span><span class=\"s1\">'summary'</span><span class=\"p\">][</span><span class=\"s1\">'total_stores'</span><span class=\"p\">]</span>\n</pre></div>\n</div>\n</dd></dl>\n\n</dd></dl>\n\n</section>\n<section id=\"module-PyOrchestrate.core.orchestrator.message_router\">\n<span id=\"pyorchestrate-core-orchestrator-message-router\"></span><h2>PyOrchestrate.core.orchestrator.message_router<a class=\"headerlink\" href=\"#module-PyOrchestrate.core.orchestrator.message_router\" title=\"Link to this heading\">\u00b6</a></h2>\n<p>Generation-aware routing of agent messages to orchestrator events.</p>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.message_router.MessageRouter\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.message_router.</span></span><span class=\"sig-name descname\"><span class=\"pre\">MessageRouter</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_bus</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">message_channel</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">logger</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.message_router.MessageRouter\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#object\" title=\"(in Python v3.11)\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">object</span></code></a></p>\n<p>Route only messages belonging to an agent\u2019s active generation.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>event_bus</strong> (<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus\" title=\"PyOrchestrate.core.orchestrator.event_bus.OrchestratorEventBus\"><em>OrchestratorEventBus</em></a>)</p></li>\n<li><p><strong>message_channel</strong> (<a class=\"reference internal\" href=\"../utilities/#PyOrchestrate.core.utilities.messaging.MessageChannel\" title=\"PyOrchestrate.core.utilities.messaging.MessageChannel\"><em>MessageChannel</em></a>)</p></li>\n<li><p><strong>logger</strong> (<em>Logger</em>)</p></li>\n</ul>\n</dd>\n</dl>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.message_router.MessageRouter.start\">\n<span class=\"sig-name descname\"><span class=\"pre\">start</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.message_router.MessageRouter.start\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.message_router.MessageRouter.stop\">\n<span class=\"sig-name descname\"><span class=\"pre\">stop</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">timeout</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">2.0</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.message_router.MessageRouter.stop\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>timeout</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#float\" title=\"(in Python v3.11)\"><em>float</em></a>)</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.message_router.MessageRouter.is_running\">\n<span class=\"sig-name descname\"><span class=\"pre\">is_running</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.message_router.MessageRouter.is_running\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#bool\" title=\"(in Python v3.11)\">bool</a></p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.message_router.MessageRouter.activate_generation\">\n<span class=\"sig-name descname\"><span class=\"pre\">activate_generation</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">generation_id</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.message_router.MessageRouter.activate_generation\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Make one generation authoritative before its instance starts.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n<li><p><strong>generation_id</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>)</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.message_router.MessageRouter.route_agent_message\">\n<span class=\"sig-name descname\"><span class=\"pre\">route_agent_message</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">msg</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.message_router.MessageRouter.route_agent_message\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Filter stale generations before interpreting any status event.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>msg</strong> (<a class=\"reference internal\" href=\"../utilities/#PyOrchestrate.core.utilities.messaging.ServiceMessage\" title=\"PyOrchestrate.core.utilities.messaging.ServiceMessage\"><em>ServiceMessage</em></a>)</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.message_router.MessageRouter.mark_agent_terminated\">\n<span class=\"sig-name descname\"><span class=\"pre\">mark_agent_terminated</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">generation_id</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.message_router.MessageRouter.mark_agent_terminated\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Mark only the matching active generation as terminated.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n<li><p><strong>generation_id</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a><em> | </em><em>None</em>)</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.message_router.MessageRouter.is_agent_terminated\">\n<span class=\"sig-name descname\"><span class=\"pre\">is_agent_terminated</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">generation_id</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.message_router.MessageRouter.is_agent_terminated\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n<li><p><strong>generation_id</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a><em> | </em><em>None</em>)</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#bool\" title=\"(in Python v3.11)\">bool</a></p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.message_router.MessageRouter.reset_termination_state\">\n<span class=\"sig-name descname\"><span class=\"pre\">reset_termination_state</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.message_router.MessageRouter.reset_termination_state\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Compatibility helper; new starts should use <code class=\"docutils literal notranslate\"><span class=\"pre\">activate_generation</span></code>.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.message_router.MessageRouter.get_terminated_agents\">\n<span class=\"sig-name descname\"><span class=\"pre\">get_terminated_agents</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.message_router.MessageRouter.get_terminated_agents\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Return names whose active generation is terminated.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Set\" title=\"(in Python v3.11)\"><em>Set</em></a>[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n</dd></dl>\n\n</section>\n<section id=\"module-PyOrchestrate.core.orchestrator.command_interface\">\n<span id=\"pyorchestrate-core-orchestrator-command-interface\"></span><h2>PyOrchestrate.core.orchestrator.command_interface<a class=\"headerlink\" href=\"#module-PyOrchestrate.core.orchestrator.command_interface\" title=\"Link to this heading\">\u00b6</a></h2>\n<p>Command Interface for Orchestrator.</p>\n<p>This module provides the CommandInterface class that manages external command\nprocessing for the orchestrator. It encapsulates ZeroMQ command channel setup,\ncommand handler integration, and message processing logic.</p>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.command_interface.CommandInterface\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.command_interface.</span></span><span class=\"sig-name descname\"><span class=\"pre\">CommandInterface</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">orchestrator</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">zmq_address</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">allowed_commands</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">event_store</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">logger</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.command_interface.CommandInterface\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#object\" title=\"(in Python v3.11)\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">object</span></code></a></p>\n<p>Manages external command interface for orchestrator.</p>\n<p>The CommandInterface encapsulates all logic for handling external commands\nfrom CLI clients. It manages:\n- ZeroMQ ROUTER socket for command communication\n- CommandHandler for executing commands\n- ChannelHandler for async message processing\n- Event tracking for command execution</p>\n<p>This class provides clean lifecycle management with start/stop methods\nand automatic error handling with event store integration.</p>\n<p class=\"rubric\">Example</p>\n<div class=\"highlight-python notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"n\">cmd_interface</span> <span class=\"o\">=</span> <span class=\"n\">CommandInterface</span><span class=\"p\">(</span>\n    <span class=\"n\">orchestrator</span><span class=\"o\">=</span><span class=\"n\">orchestrator</span><span class=\"p\">,</span>\n    <span class=\"n\">zmq_address</span><span class=\"o\">=</span><span class=\"s2\">\"tcp://*:5555\"</span><span class=\"p\">,</span>\n    <span class=\"n\">allowed_commands</span><span class=\"o\">=</span><span class=\"p\">{</span><span class=\"s2\">\"ps\"</span><span class=\"p\">,</span> <span class=\"s2\">\"shutdown\"</span><span class=\"p\">},</span>\n    <span class=\"n\">event_store</span><span class=\"o\">=</span><span class=\"n\">event_store</span><span class=\"p\">,</span>\n    <span class=\"n\">logger</span><span class=\"o\">=</span><span class=\"n\">logger</span>\n<span class=\"p\">)</span>\n\n<span class=\"c1\"># Start command interface</span>\n<span class=\"n\">cmd_interface</span><span class=\"o\">.</span><span class=\"n\">start</span><span class=\"p\">()</span>\n\n<span class=\"c1\"># Later, during shutdown</span>\n<span class=\"n\">cmd_interface</span><span class=\"o\">.</span><span class=\"n\">stop</span><span class=\"p\">()</span>\n</pre></div>\n</div>\n<dl class=\"simple\">\n<dt>Thread Safety:</dt><dd><p>This class is thread-safe. The ChannelHandler runs in a separate thread\nand handles command messages asynchronously.</p>\n</dd>\n</dl>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>zmq_address</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n<li><p><strong>allowed_commands</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#set\" title=\"(in Python v3.11)\"><em>set</em></a><em>[</em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em>] </em><em>| </em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em> | </em><em>None</em>)</p></li>\n<li><p><strong>event_store</strong> (<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.event_store.EventStore\" title=\"PyOrchestrate.core.orchestrator.event_store.EventStore\"><em>EventStore</em></a>)</p></li>\n<li><p><strong>logger</strong> (<em>Logger</em>)</p></li>\n</ul>\n</dd>\n</dl>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.command_interface.CommandInterface.start\">\n<span class=\"sig-name descname\"><span class=\"pre\">start</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.command_interface.CommandInterface.start\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Start the command interface.</p>\n<p>Creates and starts a ChannelHandler thread to process incoming\ncommand messages asynchronously. The handler will continuously\npoll the command channel and invoke handle_command for each message.</p>\n<p>This method should be called during orchestrator initialization.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/exceptions.html#RuntimeError\" title=\"(in Python v3.11)\"><strong>RuntimeError</strong></a> \u2013 If command interface is already started</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.command_interface.CommandInterface.stop\">\n<span class=\"sig-name descname\"><span class=\"pre\">stop</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">timeout</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">2.0</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.command_interface.CommandInterface.stop\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Stop the command interface gracefully.</p>\n<p>Stops the channel handler thread and closes the command channel.\nThis method blocks until the handler thread terminates or timeout expires.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>timeout</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#float\" title=\"(in Python v3.11)\"><em>float</em></a>) \u2013 Maximum time to wait for handler thread to stop (seconds)</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.command_interface.CommandInterface.handle_command\">\n<span class=\"sig-name descname\"><span class=\"pre\">handle_command</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">request_msg</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.command_interface.CommandInterface.handle_command\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Process external command from CLI client.</p>\n<p>This method is invoked by ChannelHandler for each incoming command message.\nIt validates the request, executes the command via CommandHandler, tracks\nerrors to event store, and sends response back to the client.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>request_msg</strong> (<a class=\"reference internal\" href=\"../utilities/#PyOrchestrate.core.utilities.messaging.ServiceMessage\" title=\"PyOrchestrate.core.utilities.messaging.ServiceMessage\"><em>ServiceMessage</em></a>) \u2013 ServiceMessage containing command request</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n<dl class=\"simple\">\n<dt>Error Handling:</dt><dd><ul class=\"simple\">\n<li><p>Validation errors are tracked to event store and returned as error responses</p></li>\n<li><p>Command execution errors are caught, logged, tracked, and returned as error responses</p></li>\n<li><p>All errors result in structured ServiceMessage error responses sent back to client</p></li>\n</ul>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.command_interface.CommandInterface.is_running\">\n<span class=\"sig-name descname\"><span class=\"pre\">is_running</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.command_interface.CommandInterface.is_running\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Check if command interface is currently running.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>True if channel handler is running, False otherwise</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#bool\" title=\"(in Python v3.11)\">bool</a></p>\n</dd>\n</dl>\n</dd></dl>\n\n</dd></dl>\n\n</section>\n<section id=\"module-PyOrchestrate.core.orchestrator.channel_handler\">\n<span id=\"pyorchestrate-core-orchestrator-channel-handler\"></span><h2>PyOrchestrate.core.orchestrator.channel_handler<a class=\"headerlink\" href=\"#module-PyOrchestrate.core.orchestrator.channel_handler\" title=\"Link to this heading\">\u00b6</a></h2>\n<p>Channel Handler Module</p>\n<p>This module provides the ChannelHandler class for managing message channel\ncommunication in separate threads, encapsulating thread lifecycle management.</p>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.channel_handler.ChannelHandler\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.channel_handler.</span></span><span class=\"sig-name descname\"><span class=\"pre\">ChannelHandler</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">channel</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">message_handler</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">name</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">'ChannelHandler'</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">logger</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">poll_timeout</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">1.0</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.channel_handler.ChannelHandler\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#object\" title=\"(in Python v3.11)\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">object</span></code></a></p>\n<p>Handles message channel communication in a separate thread.</p>\n<p>Encapsulates thread lifecycle management for message processing,\nproviding a clean interface for starting, stopping, and handling\nmessages from a MessageChannel.</p>\n<p>This class follows the Single Responsibility Principle by managing\nonly the thread lifecycle and message polling, delegating message\nprocessing to a provided callback function.</p>\n<p>The polling thread is a daemon, so it never keeps the interpreter alive.\nTwo guarantees keep it from aborting the process on the way out: a channel\nclosed underneath the loop ends the loop instead of being logged once per\npoll, and an <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/atexit.html#module-atexit\" title=\"(in Python v3.11)\"><code class=\"xref py py-mod docutils literal notranslate\"><span class=\"pre\">atexit</span></code></a> hook signals and joins any handler still running\nwhen the interpreter starts exiting.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Variables<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>channel</strong> (<a class=\"reference internal\" href=\"../utilities/#PyOrchestrate.core.utilities.messaging.MessageChannel\" title=\"PyOrchestrate.core.utilities.messaging.MessageChannel\"><em>MessageChannel</em></a>) \u2013 The message channel to monitor.</p></li>\n<li><p><strong>message_handler</strong> (<em>Callable</em>) \u2013 Callback function to process received messages.</p></li>\n<li><p><strong>name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 Thread name for identification and logging.</p></li>\n<li><p><strong>logger</strong> \u2013 Logger instance for debugging and error tracking.</p></li>\n<li><p><strong>poll_timeout</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#float\" title=\"(in Python v3.11)\"><em>float</em></a>) \u2013 Timeout for channel polling in seconds.</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><ul class=\"simple\">\n<li><p><strong>channel</strong> (<a class=\"reference internal\" href=\"../utilities/#PyOrchestrate.core.utilities.messaging.MessageChannel\" title=\"PyOrchestrate.core.utilities.messaging.MessageChannel\"><em>MessageChannel</em></a>)</p></li>\n<li><p><strong>message_handler</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Callable\" title=\"(in Python v3.11)\"><em>Callable</em></a><em>[</em><em>[</em><a class=\"reference internal\" href=\"../utilities/#PyOrchestrate.core.utilities.messaging.ServiceMessage\" title=\"PyOrchestrate.core.utilities.messaging.ServiceMessage\"><em>ServiceMessage</em></a><em>]</em><em>, </em><em>None</em><em>]</em>)</p></li>\n<li><p><strong>name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n<li><p><strong>poll_timeout</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#float\" title=\"(in Python v3.11)\"><em>float</em></a>)</p></li>\n</ul>\n</dd>\n</dl>\n<p class=\"rubric\">Example</p>\n<div class=\"doctest highlight-default notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"gp\">&gt;&gt;&gt; </span><span class=\"c1\"># Create a handler for agent messages</span>\n<span class=\"gp\">&gt;&gt;&gt; </span><span class=\"n\">handler</span> <span class=\"o\">=</span> <span class=\"n\">ChannelHandler</span><span class=\"p\">(</span>\n<span class=\"gp\">... </span>    <span class=\"n\">channel</span><span class=\"o\">=</span><span class=\"n\">msg_channel</span><span class=\"p\">,</span>\n<span class=\"gp\">... </span>    <span class=\"n\">message_handler</span><span class=\"o\">=</span><span class=\"n\">orchestrator</span><span class=\"o\">.</span><span class=\"n\">handle_agent_message</span><span class=\"p\">,</span>\n<span class=\"gp\">... </span>    <span class=\"n\">name</span><span class=\"o\">=</span><span class=\"s2\">\"AgentMessageHandler\"</span><span class=\"p\">,</span>\n<span class=\"gp\">... </span>    <span class=\"n\">logger</span><span class=\"o\">=</span><span class=\"n\">orchestrator</span><span class=\"o\">.</span><span class=\"n\">logger</span><span class=\"p\">,</span>\n<span class=\"gp\">... </span>    <span class=\"n\">poll_timeout</span><span class=\"o\">=</span><span class=\"mf\">1.0</span>\n<span class=\"gp\">... </span><span class=\"p\">)</span>\n<span class=\"gp\">&gt;&gt;&gt; </span><span class=\"n\">handler</span><span class=\"o\">.</span><span class=\"n\">start</span><span class=\"p\">()</span>\n<span class=\"gp\">&gt;&gt;&gt; </span><span class=\"c1\"># ... do work ...</span>\n<span class=\"gp\">&gt;&gt;&gt; </span><span class=\"n\">handler</span><span class=\"o\">.</span><span class=\"n\">stop</span><span class=\"p\">(</span><span class=\"n\">timeout</span><span class=\"o\">=</span><span class=\"mf\">2.0</span><span class=\"p\">)</span>\n</pre></div>\n</div>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.channel_handler.ChannelHandler.start\">\n<span class=\"sig-name descname\"><span class=\"pre\">start</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.channel_handler.ChannelHandler.start\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Start the message handling thread.</p>\n<p>Creates and starts a daemon thread that continuously polls the message channel\nand invokes the message handler callback for each received message.</p>\n<p class=\"rubric\">Notes</p>\n<ul class=\"simple\">\n<li><p>If the handler is already running, this method logs a warning and returns.</p></li>\n<li><p>The thread is created as a daemon to allow graceful application shutdown.</p></li>\n<li><p>Uses the configured name for easy identification in thread dumps.</p></li>\n<li><p>The handler is registered for the atexit backstop, which stops it\neven if nobody calls <a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.channel_handler.ChannelHandler.stop\" title=\"PyOrchestrate.core.orchestrator.channel_handler.ChannelHandler.stop\"><code class=\"xref py py-meth docutils literal notranslate\"><span class=\"pre\">stop()</span></code></a>.</p></li>\n</ul>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.channel_handler.ChannelHandler.stop\">\n<span class=\"sig-name descname\"><span class=\"pre\">stop</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">timeout</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">2.0</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.channel_handler.ChannelHandler.stop\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Stop the message handling thread.</p>\n<p>Signals the thread to stop and waits for it to terminate gracefully.\nIf the thread doesn\u2019t stop within the timeout period, a warning is logged.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>timeout</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#float\" title=\"(in Python v3.11)\"><em>float</em></a>) \u2013 Maximum time in seconds to wait for thread termination.\nDefaults to 2.0 seconds.</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n<p class=\"rubric\">Notes</p>\n<ul class=\"simple\">\n<li><p>This method is idempotent - calling it multiple times is safe.</p></li>\n<li><p>The thread will complete processing the current message before stopping.</p></li>\n<li><p>If the thread is stuck, it will be left as a daemon and eventually\nterminated when the application exits.</p></li>\n<li><p>A thread that already left its loop on its own, because the channel\nwas closed, is still joined and cleared here.</p></li>\n</ul>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.channel_handler.ChannelHandler.is_running\">\n<span class=\"sig-name descname\"><span class=\"pre\">is_running</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.channel_handler.ChannelHandler.is_running\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Check if the handler is currently running.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>True if the handler thread is active, False otherwise.</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#bool\" title=\"(in Python v3.11)\">bool</a></p>\n</dd>\n</dl>\n</dd></dl>\n\n</dd></dl>\n\n</section>\n<section id=\"module-PyOrchestrate.core.orchestrator.memory\">\n<span id=\"pyorchestrate-core-orchestrator-memory\"></span><h2>PyOrchestrate.core.orchestrator.memory<a class=\"headerlink\" href=\"#module-PyOrchestrate.core.orchestrator.memory\" title=\"Link to this heading\">\u00b6</a></h2>\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentLifecycleState\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.memory.</span></span><span class=\"sig-name descname\"><span class=\"pre\">AgentLifecycleState</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">value</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">names=&lt;not</span> <span class=\"pre\">given&gt;</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">*values</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">module=None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">qualname=None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">type=None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">start=1</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">boundary=None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentLifecycleState\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/enum.html#enum.Enum\" title=\"(in Python v3.11)\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">Enum</span></code></a></p>\n<p>Parent-process lifecycle state for an orchestrated agent entry.</p>\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.REGISTERED\">\n<span class=\"sig-name descname\"><span class=\"pre\">REGISTERED</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'registered'</span></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.REGISTERED\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.STARTING\">\n<span class=\"sig-name descname\"><span class=\"pre\">STARTING</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'starting'</span></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.STARTING\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.RUNNING\">\n<span class=\"sig-name descname\"><span class=\"pre\">RUNNING</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'running'</span></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.RUNNING\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.STOPPING\">\n<span class=\"sig-name descname\"><span class=\"pre\">STOPPING</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'stopping'</span></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.STOPPING\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.TERMINATED\">\n<span class=\"sig-name descname\"><span class=\"pre\">TERMINATED</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'terminated'</span></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.TERMINATED\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.FAILED\">\n<span class=\"sig-name descname\"><span class=\"pre\">FAILED</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'failed'</span></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.FAILED\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.QUARANTINED\">\n<span class=\"sig-name descname\"><span class=\"pre\">QUARANTINED</span></span><em class=\"property\"><span class=\"w\"> </span><span class=\"p\"><span class=\"pre\">=</span></span><span class=\"w\"> </span><span class=\"pre\">'quarantined'</span></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentLifecycleState.QUARANTINED\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n</dd></dl>\n\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentStartAttempt\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.memory.</span></span><span class=\"sig-name descname\"><span class=\"pre\">AgentStartAttempt</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">generation_id</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentStartAttempt\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#object\" title=\"(in Python v3.11)\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">object</span></code></a></p>\n<p>Identity of one prepared startup generation.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n<li><p><strong>generation_id</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><em>int</em></a>)</p></li>\n</ul>\n</dd>\n</dl>\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentStartAttempt.agent_name\">\n<span class=\"sig-name descname\"><span class=\"pre\">agent_name</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><span class=\"pre\">str</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentStartAttempt.agent_name\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n<dl class=\"py attribute\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentStartAttempt.generation_id\">\n<span class=\"sig-name descname\"><span class=\"pre\">generation_id</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><span class=\"pre\">int</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentStartAttempt.generation_id\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd></dd></dl>\n\n</dd></dl>\n\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentEntry\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.memory.</span></span><span class=\"sig-name descname\"><span class=\"pre\">AgentEntry</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_class</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">name</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">control_events</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">state_events</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">config</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">plugin</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">record_event_callback</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#object\" title=\"(in Python v3.11)\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">object</span></code></a></p>\n<p>AgentEntry is a class that stores metadata and the instance of an agent.</p>\n<p class=\"rubric\">Notes</p>\n<p>You can access state and control events to manage the agent\u2019s lifecycle.</p>\n<p class=\"rubric\">Examples</p>\n<div class=\"doctest highlight-default notranslate\"><div class=\"highlight\"><pre><span></span><span class=\"gp\">&gt;&gt;&gt; </span><span class=\"kn\">from</span><span class=\"w\"> </span><span class=\"nn\">PyOrchestrate.core.orchestrator</span><span class=\"w\"> </span><span class=\"kn\">import</span> <span class=\"n\">Orchestrator</span>\n<span class=\"gp\">&gt;&gt;&gt; </span><span class=\"kn\">from</span><span class=\"w\"> </span><span class=\"nn\">models</span><span class=\"w\"> </span><span class=\"kn\">import</span> <span class=\"n\">FileWriter</span>\n<span class=\"gp\">&gt;&gt;&gt;</span>\n<span class=\"gp\">&gt;&gt;&gt; </span><span class=\"n\">orchestrator</span> <span class=\"o\">=</span> <span class=\"n\">Orchestrator</span><span class=\"p\">(</span><span class=\"s2\">\"CoolOrchestrator\"</span><span class=\"p\">)</span>\n<span class=\"gp\">&gt;&gt;&gt; </span><span class=\"n\">fw_agent</span><span class=\"p\">:</span> <span class=\"n\">AgentEntry</span> <span class=\"o\">=</span> <span class=\"n\">orchestrator</span><span class=\"o\">.</span><span class=\"n\">register_agent</span><span class=\"p\">(</span><span class=\"n\">FileWriter</span><span class=\"p\">,</span> <span class=\"s2\">\"FileWriter\"</span><span class=\"p\">)</span>\n<span class=\"gp\">&gt;&gt;&gt; </span><span class=\"n\">orchestrator</span><span class=\"o\">.</span><span class=\"n\">start</span><span class=\"p\">()</span>\n<span class=\"gp\">&gt;&gt;&gt; </span><span class=\"n\">fw_agent</span><span class=\"o\">.</span><span class=\"n\">state_events</span><span class=\"o\">.</span><span class=\"n\">ready_event</span><span class=\"o\">.</span><span class=\"n\">wait</span><span class=\"p\">()</span>\n<span class=\"gp\">&gt;&gt;&gt; </span><span class=\"nb\">print</span><span class=\"p\">(</span><span class=\"s2\">\"agent is now ready\"</span><span class=\"p\">)</span>\n</pre></div>\n</div>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Variables<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>agent_class</strong> (<em>Type</em><em>[</em><a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.BaseAgent\" title=\"PyOrchestrate.core.agent.base_agent.BaseAgent\"><em>BaseAgent</em></a><em>]</em>) \u2013 The class of the agent.</p></li>\n<li><p><strong>name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 The name of the agent.</p></li>\n<li><p><strong>control_events</strong> (<a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.BaseAgent.ControlEvents\" title=\"PyOrchestrate.core.agent.base_agent.BaseAgent.ControlEvents\"><em>BaseAgent.ControlEvents</em></a>) \u2013 Control events for the agent.</p></li>\n<li><p><strong>state_events</strong> (<a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.BaseAgent.StateEvents\" title=\"PyOrchestrate.core.agent.base_agent.BaseAgent.StateEvents\"><em>BaseAgent.StateEvents</em></a>) \u2013 State events for the agent.</p></li>\n<li><p><strong>config</strong> (<em>Optional</em><em>[</em><em>BaseConfig</em><em>]</em>) \u2013 Custom configuration for the agent.</p></li>\n<li><p><strong>plugin</strong> (<em>Optional</em><em>[</em><em>BasePlugin</em><em>]</em>) \u2013 Custom plugin for the agent.</p></li>\n<li><p><strong>_record_event_callback</strong> (<em>Optional</em><em>[</em><em>Any</em><em>]</em>) \u2013 Callback to record events.</p></li>\n<li><p><strong>kwargs</strong> (<em>Any</em>) \u2013 Additional keyword arguments for the agent.</p></li>\n<li><p><strong>instance</strong> (<a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.BaseAgent\" title=\"PyOrchestrate.core.agent.base_agent.BaseAgent\"><em>BaseAgent</em></a>) \u2013 The agent instance.</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><ul class=\"simple\">\n<li><p><strong>agent_class</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Type\" title=\"(in Python v3.11)\"><em>Type</em></a><em>[</em><a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.AgentProtocol\" title=\"PyOrchestrate.core.agent.base_agent.AgentProtocol\"><em>AgentProtocol</em></a><em>]</em>)</p></li>\n<li><p><strong>name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n<li><p><strong>control_events</strong> (<a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.BaseAgent.ControlEvents\" title=\"PyOrchestrate.core.agent.base_agent.BaseAgent.ControlEvents\"><em>ControlEvents</em></a><em> | </em><em>None</em>)</p></li>\n<li><p><strong>state_events</strong> (<a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.BaseAgent.StateEvents\" title=\"PyOrchestrate.core.agent.base_agent.BaseAgent.StateEvents\"><em>StateEvents</em></a><em> | </em><em>None</em>)</p></li>\n<li><p><strong>config</strong> (<a class=\"reference internal\" href=\"../base/#PyOrchestrate.core.base.BaseClassConfig\" title=\"PyOrchestrate.core.base.base.BaseClassConfig\"><em>BaseClassConfig</em></a><em> | </em><em>None</em>)</p></li>\n<li><p><strong>plugin</strong> (<a class=\"reference internal\" href=\"../base/#PyOrchestrate.core.base.BaseClassPlugin\" title=\"PyOrchestrate.core.base.base.BaseClassPlugin\"><em>BaseClassPlugin</em></a><em> | </em><em>None</em>)</p></li>\n<li><p><strong>record_event_callback</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Any\" title=\"(in Python v3.11)\"><em>Any</em></a><em> | </em><em>None</em>)</p></li>\n<li><p><strong>kwargs</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.Any\" title=\"(in Python v3.11)\"><em>Any</em></a>)</p></li>\n</ul>\n</dd>\n</dl>\n<dl class=\"py property\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentEntry.state\">\n<em class=\"property\"><span class=\"pre\">property</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">state</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentLifecycleState\" title=\"PyOrchestrate.core.orchestrator.memory.AgentLifecycleState\"><span class=\"pre\">AgentLifecycleState</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry.state\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Return the lifecycle state tracked by the orchestrator process.</p>\n</dd></dl>\n\n<dl class=\"py property\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentEntry.generation_id\">\n<em class=\"property\"><span class=\"pre\">property</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">generation_id</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#int\" title=\"(in Python v3.11)\"><span class=\"pre\">int</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry.generation_id\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Return the generation assigned to the current instance.</p>\n</dd></dl>\n\n<dl class=\"py property\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentEntry.is_initialized\">\n<em class=\"property\"><span class=\"pre\">property</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">is_initialized</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#bool\" title=\"(in Python v3.11)\"><span class=\"pre\">bool</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry.is_initialized\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Return whether the concrete thread/process instance exists.</p>\n</dd></dl>\n\n<dl class=\"py property\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentEntry.instance\">\n<em class=\"property\"><span class=\"pre\">property</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">instance</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.AgentProtocol\" title=\"PyOrchestrate.core.agent.base_agent.AgentProtocol\"><span class=\"pre\">AgentProtocol</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry.instance\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get the agent instance.</p>\n<p class=\"rubric\">Notes</p>\n<p>An entry only has an instance once a startup attempt created one, so\na registered or queued agent has none. Use <cite>is_initialized</cite> to check\nbefore reading this.</p>\n<p>The guard used to be an <cite>assert</cite>, which <cite>python -O</cite> strips: the\nproperty then returned <cite>None</cite>, turning a clear failure here into an\n<cite>AttributeError</cite> somewhere further away.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>The agent instance.</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.BaseAgent\" title=\"PyOrchestrate.core.agent.base_agent.BaseAgent\">BaseAgent</a></p>\n</dd>\n<dt class=\"field-odd\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/exceptions.html#RuntimeError\" title=\"(in Python v3.11)\"><strong>RuntimeError</strong></a> \u2013 If the agent has no instance yet.</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py property\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentEntry.start_cancel_requested\">\n<em class=\"property\"><span class=\"pre\">property</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">start_cancel_requested</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#bool\" title=\"(in Python v3.11)\"><span class=\"pre\">bool</span></a></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry.start_cancel_requested\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Return whether startup cancellation was requested.</p>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentEntry.is_alive\">\n<span class=\"sig-name descname\"><span class=\"pre\">is_alive</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">attempt</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry.is_alive\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Check if the agent instance is alive.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>True if the agent instance is alive, False otherwise.</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#bool\" title=\"(in Python v3.11)\">bool</a></p>\n</dd>\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>attempt</strong> (<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentStartAttempt\" title=\"PyOrchestrate.core.orchestrator.memory.AgentStartAttempt\"><em>AgentStartAttempt</em></a><em> | </em><em>None</em>)</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.AgentEntry.status\">\n<span class=\"sig-name descname\"><span class=\"pre\">status</span></span><span class=\"sig-paren\">(</span><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry.status\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get agent status.</p>\n<p class=\"rubric\">Notes</p>\n<p>The status is a string containing the following information:</p>\n<ul class=\"simple\">\n<li><p>Whether the agent is alive.</p></li>\n<li><p>Whether the agent is a daemon.</p></li>\n<li><p>The agent\u2019s ident (if it is a process).</p></li>\n<li><p>The agent\u2019s PID (if it is a process).</p></li>\n</ul>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>Agent status.</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a></p>\n</dd>\n</dl>\n</dd></dl>\n\n</dd></dl>\n\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.Group\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.memory.</span></span><span class=\"sig-name descname\"><span class=\"pre\">Group</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.Group\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#object\" title=\"(in Python v3.11)\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">object</span></code></a></p>\n<p>A group of agents.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p>\n</dd>\n</dl>\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.Group.add_agent\">\n<span class=\"sig-name descname\"><span class=\"pre\">add_agent</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.Group.add_agent\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Adds an agent (identified by its name) to the group.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.Group.remove_agent\">\n<span class=\"sig-name descname\"><span class=\"pre\">remove_agent</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.Group.remove_agent\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Removes an agent from the group.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n</dd></dl>\n\n<dl class=\"py class\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.OMemory\">\n<em class=\"property\"><span class=\"pre\">class</span><span class=\"w\"> </span></em><span class=\"sig-prename descclassname\"><span class=\"pre\">PyOrchestrate.core.orchestrator.memory.</span></span><span class=\"sig-name descname\"><span class=\"pre\">OMemory</span></span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.OMemory\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Bases: <a class=\"reference external\" href=\"https://docs.python.org/3.11/library/functions.html#object\" title=\"(in Python v3.11)\"><code class=\"xref py py-class docutils literal notranslate\"><span class=\"pre\">object</span></code></a></p>\n<p>OMemory is a class that stores agents and groups of agents.</p>\n<p>Agents are stored as <cite>AgentEntry</cite> objects, which contain some metadata and the agent instance.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Variables<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>_agents</strong> (<em>Dict</em><em>[</em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em>, </em><a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry\" title=\"PyOrchestrate.core.orchestrator.memory.AgentEntry\"><em>AgentEntry</em></a><em>]</em>) \u2013 Map from agent name to <cite>AgentEntry</cite> object.</p></li>\n<li><p><strong>_groups</strong> (<em>Dict</em><em>[</em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em>, </em><a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.memory.Group\" title=\"PyOrchestrate.core.orchestrator.memory.Group\"><em>Group</em></a><em>]</em>) \u2013 Map from group name to <cite>Group</cite> object.</p></li>\n<li><p><strong>_agents_history</strong> (<em>Dict</em><em>[</em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em>, </em><em>List</em><em>[</em><em>Dict</em><em>[</em><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a><em>, </em><em>Any</em><em>]</em><em>]</em><em>]</em>) \u2013 Map from agent name to a list of recorded events.</p></li>\n</ul>\n</dd>\n</dl>\n<dl class=\"py property\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.OMemory.agents\">\n<em class=\"property\"><span class=\"pre\">property</span><span class=\"w\"> </span></em><span class=\"sig-name descname\"><span class=\"pre\">agents</span></span><em class=\"property\"><span class=\"p\"><span class=\"pre\">:</span></span><span class=\"w\"> </span><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#list\" title=\"(in Python v3.11)\"><span class=\"pre\">list</span></a><span class=\"p\"><span class=\"pre\">[</span></span><a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry\" title=\"PyOrchestrate.core.orchestrator.memory.AgentEntry\"><span class=\"pre\">AgentEntry</span></a><span class=\"p\"><span class=\"pre\">]</span></span></em><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.OMemory.agents\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Return the list of all <cite>AgentEntry</cite> objects.</p>\n<p>These objects contain all the information needed to manage an agent.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>List of all agents.</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#list\" title=\"(in Python v3.11)\">list</a>[<a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry\" title=\"PyOrchestrate.core.orchestrator.memory.AgentEntry\">AgentEntry</a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.OMemory.add_agent\">\n<span class=\"sig-name descname\"><span class=\"pre\">add_agent</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_class</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">name</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">custom_config</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">custom_plugin</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">control_events</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">state_events</span></span><span class=\"o\"><span class=\"pre\">=</span></span><span class=\"default_value\"><span class=\"pre\">None</span></span></em>, <em class=\"sig-param\"><span class=\"o\"><span class=\"pre\">**</span></span><span class=\"n\"><span class=\"pre\">kwargs</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.OMemory.add_agent\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Store an agent in the orchestrator memory.</p>\n<p>Data will be stored as an <cite>AgentEntry</cite> object, which contains metadata and the agent instance. The agent will be\ninitialized and its control events will be set to ready by default.</p>\n<p class=\"rubric\">Notes</p>\n<p>Every agent has a set of events that can be used to control its lifecycle. By default, all <cite>ControlEvents</cite> are\nset to ready. If no custom events are provided, the default events will be created.</p>\n<p>Events from agents are handled centrally by the orchestrator\u2019s event manager.\nAgents communicate with the orchestrator via message channel.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>agent_class</strong> (<em>Type</em><em>[</em><a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.BaseAgent\" title=\"PyOrchestrate.core.agent.base_agent.BaseAgent\"><em>BaseAgent</em></a><em>]</em>) \u2013 The class of the agent to store.</p></li>\n<li><p><strong>name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 The name of the agent.</p></li>\n<li><p><strong>custom_config</strong> (<em>BaseConfig</em><em>, </em><em>optional</em>) \u2013 Custom configuration for the agent. Defaults to None.</p></li>\n<li><p><strong>custom_plugin</strong> (<em>BasePlugin</em><em>, </em><em>optional</em>) \u2013 Custom plugin for the agent. Defaults to None.</p></li>\n<li><p><strong>control_events</strong> (<a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.BaseAgent.ControlEvents\" title=\"PyOrchestrate.core.agent.base_agent.BaseAgent.ControlEvents\"><em>BaseAgent.ControlEvents</em></a><em>, </em><em>optional</em>) \u2013 Control events for the agent. Defaults to None.</p></li>\n<li><p><strong>state_events</strong> (<a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.BaseAgent.StateEvents\" title=\"PyOrchestrate.core.agent.base_agent.BaseAgent.StateEvents\"><em>BaseAgent.StateEvents</em></a><em>, </em><em>optional</em>) \u2013 State events for the agent. Defaults to None.</p></li>\n<li><p><strong>kwargs</strong> (<em>Any</em>) \u2013 Additional keyword arguments for the agent.</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>The <cite>AgentEntry</cite> object corresponding to the stored agent.</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry\" title=\"PyOrchestrate.core.orchestrator.memory.AgentEntry\">AgentEntry</a></p>\n</dd>\n<dt class=\"field-even\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/exceptions.html#ValueError\" title=\"(in Python v3.11)\"><strong>ValueError</strong></a> \u2013 If the agent already exists.</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.OMemory.create_group\">\n<span class=\"sig-name descname\"><span class=\"pre\">create_group</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">group_name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.OMemory.create_group\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Creates an empty group, unless it already exists.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>group_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.OMemory.add_agent_to_group\">\n<span class=\"sig-name descname\"><span class=\"pre\">add_agent_to_group</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">group_name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.OMemory.add_agent_to_group\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Adds an existing agent to the given group, when the group exists.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n<li><p><strong>group_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.OMemory.remove_agent_from_group\">\n<span class=\"sig-name descname\"><span class=\"pre\">remove_agent_from_group</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span></em>, <em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">group_name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.OMemory.remove_agent_from_group\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Removes an agent from the given group, when the group exists.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><ul class=\"simple\">\n<li><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n<li><p><strong>group_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p></li>\n</ul>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.OMemory.get_group\">\n<span class=\"sig-name descname\"><span class=\"pre\">get_group</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">group_name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.OMemory.get_group\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Returns the <cite>Group</cite> object, when it exists.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>group_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.memory.Group\" title=\"PyOrchestrate.core.orchestrator.memory.Group\"><em>Group</em></a> | None</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.OMemory.get_group_agents\">\n<span class=\"sig-name descname\"><span class=\"pre\">get_group_agents</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">group_name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.OMemory.get_group_agents\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Returns the list of agent instances belonging to the group.</p>\n<p class=\"rubric\">Notes</p>\n<p>Only agents that have been started have an instance. A member that\nis merely registered, or still waiting in the worker queue, is\nskipped: reading <cite>entry.instance</cite> for it used to raise instead of\nreturning the group\u2019s running agents.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>group_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>)</p>\n</dd>\n<dt class=\"field-even\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/typing.html#typing.List\" title=\"(in Python v3.11)\"><em>List</em></a>[<a class=\"reference internal\" href=\"../agent/#PyOrchestrate.core.agent.base_agent.AgentProtocol\" title=\"PyOrchestrate.core.agent.base_agent.AgentProtocol\"><em>AgentProtocol</em></a>]</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.OMemory.get_agent_stats\">\n<span class=\"sig-name descname\"><span class=\"pre\">get_agent_stats</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">agent_name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.OMemory.get_agent_stats\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Return the event log for the specified agent.</p>\n<p>If the agent does not exist or has no events, return None.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>agent_name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 The name of the agent.</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>The event log for the agent or None.</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>Optional[List[Dict[<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\">str</a>, datetime]]]</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.OMemory.get_agent\">\n<span class=\"sig-name descname\"><span class=\"pre\">get_agent</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.OMemory.get_agent\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get the <cite>AgentEntry</cite> object corresponding to the provided name.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 The name of the agent to retrieve.</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>The <cite>AgentEntry</cite> object corresponding to the provided name, or None if not found.</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.memory.AgentEntry\" title=\"PyOrchestrate.core.orchestrator.memory.AgentEntry\">AgentEntry</a> | None</p>\n</dd>\n<dt class=\"field-even\">Raises<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p><a class=\"reference external\" href=\"https://docs.python.org/3.11/library/exceptions.html#ValueError\" title=\"(in Python v3.11)\"><strong>ValueError</strong></a> \u2013 If the agent is not found.</p>\n</dd>\n</dl>\n</dd></dl>\n\n<dl class=\"py method\">\n<dt class=\"sig sig-object py\" id=\"PyOrchestrate.core.orchestrator.memory.OMemory.get_agent_instance\">\n<span class=\"sig-name descname\"><span class=\"pre\">get_agent_instance</span></span><span class=\"sig-paren\">(</span><em class=\"sig-param\"><span class=\"n\"><span class=\"pre\">name</span></span></em><span class=\"sig-paren\">)</span><a class=\"headerlink\" href=\"#PyOrchestrate.core.orchestrator.memory.OMemory.get_agent_instance\" title=\"Link to this definition\">\u00b6</a></dt>\n<dd><p>Get the agent instance for the provided name.</p>\n<dl class=\"field-list simple\">\n<dt class=\"field-odd\">Parameters<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p><strong>name</strong> (<a class=\"reference external\" href=\"https://docs.python.org/3.11/library/stdtypes.html#str\" title=\"(in Python v3.11)\"><em>str</em></a>) \u2013 The name of the agent to retrieve.</p>\n</dd>\n<dt class=\"field-even\">Returns<span class=\"colon\">:</span></dt>\n<dd class=\"field-even\"><p>The agent instance, or None if not found.</p>\n</dd>\n<dt class=\"field-odd\">Return type<span class=\"colon\">:</span></dt>\n<dd class=\"field-odd\"><p>ProcessAgent | ThreadAgent | None</p>\n</dd>\n</dl>\n</dd></dl>\n\n</dd></dl>\n\n</section>\n</section>\n", "metatags": "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\" />\n", "rellinks": [["genindex", "General Index", "I", "index"], ["py-modindex", "Python Module Index", "", "modules"], ["plugins", "Plugins", "N", "next"], ["agent", "Agents", "P", "previous"]], "sourcename": "orchestrator.rst.txt", "toc": "<ul>\n<li><a class=\"reference internal\" href=\"#\">Orchestrator</a><ul>\n<li><a class=\"reference internal\" href=\"#module-PyOrchestrate.core.orchestrator.orchestrator\">PyOrchestrate.core.orchestrator.orchestrator</a><ul>\n<li><a class=\"reference internal\" href=\"#PyOrchestrate.core.orchestrator.orchestrator.RunMode\"><code class=\"docutils literal notranslate\"><span class=\"pre\">RunMode</span><